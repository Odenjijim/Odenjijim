// This is your Prisma schema file.\n// Learn more about it in the docs: https://pris.ly/d/prisma-schema\n\ngenerator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\n/**\n * LAYER 1: IDENTITY SECURITY\n * User & Authentication Models\n */\nmodel User {\n  id            String    @id @default(cuid())\n  email         String    @unique\n  name          String?\n  passwordHash  String\n  avatar        String?\n  mfaEnabled    Boolean   @default(false)\n  createdAt     DateTime  @default(now())\n  updatedAt     DateTime  @updatedAt\n\n  // Relations\n  mfaMethods    MFAMethod[]\n  sessions      Session[]\n  behavioralMetrics BehavioralMetric[]\n  wearableData  WearableData[]\n  consents      ConsentRecord[]\n  auditLogs     AuditLog[]\n  aiInteractions AIInteraction[]\n\n  @@index([email])\n}\n\n/**\n * LAYER 1: IDENTITY SECURITY\n * MFA Methods\n */\nmodel MFAMethod {\n  id        String    @id @default(cuid())\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String    // 'authenticator' | 'biometric' | 'hardware'\n  verified  Boolean   @default(false)\n  secret    String?   @db.Text // Encrypted\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n\n  @@index([userId])\n}\n\n/**\n * LAYER 1: IDENTITY SECURITY\n * Session Management\n */\nmodel Session {\n  id        String    @id @default(cuid())\n  sessionToken String  @unique\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  expires   DateTime\n  createdAt DateTime  @default(now())\n  ipAddress String?\n  userAgent String?   @db.Text\n\n  @@index([userId])\n  @@index([sessionToken])\n}\n\n/**\n * LAYER 5: BEHAVIORAL RISK DETECTION\n * Behavioral Metrics for DSS Calculation\n */\nmodel BehavioralMetric {\n  id            String    @id @default(cuid())\n  userId        String\n  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  timestamp     DateTime  @default(now())\n  stability     Int       // 0-100: Emotional stability score\n  stressLevel   Int       // 0-100: Current stress level\n  recoveryScore Int       // 0-100: Progress toward recovery goals\n  notes         String?   @db.Text // User-provided notes (encrypted)\n  dssScore      Int?      // Calculated DSS score\n\n  @@index([userId])\n  @@index([timestamp])\n}\n\n/**\n * LAYER 3: BIOMETRIC DATA COMPLIANCE\n * Wearable Device Data\n */\nmodel WearableData {\n  id            String    @id @default(cuid())\n  userId        String\n  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  deviceId      String    // Device identifier\n  deviceType    String    // 'apple_health' | 'google_fit' | 'fitbit' | etc.\n  heartRate     Int?\n  sleepDuration Float?    // Hours\n  steps         Int?\n  calories      Int?\n  timestamp     DateTime  @default(now())\n  syncedAt      DateTime  @default(now())\n\n  @@index([userId])\n  @@index([deviceId])\n  @@index([timestamp])\n}\n\n/**\n * LAYER 3: BIOMETRIC DATA COMPLIANCE\n * Wearable Device Connections\n */\nmodel WearableDevice {\n  id            String    @id @default(cuid())\n  userId        String    @unique\n  deviceType    String    // 'apple_health' | 'google_fit' | etc.\n  connected     Boolean   @default(true)\n  accessToken   String?   @db.Text // Encrypted\n  refreshToken  String?   @db.Text // Encrypted\n  lastSync      DateTime?\n  createdAt     DateTime  @default(now())\n  updatedAt     DateTime  @updatedAt\n\n  @@index([userId])\n}\n\n/**\n * LAYER 3 & 7: BIOMETRIC DATA COMPLIANCE & COMPLIANCE FRAMEWORK\n * User Consent Records\n */\nmodel ConsentRecord {\n  id        String    @id @default(cuid())\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type      String    // 'biometric' | 'behavioral' | 'wearable' | 'ai_interaction'\n  granted   Boolean\n  grantedAt DateTime?\n  expiresAt DateTime?\n  revokedAt DateTime?\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n\n  @@index([userId])\n  @@index([type])\n}\n\n/**\n * LAYER 6: ACCESS CONTROL\n * Audit Logging\n */\nmodel AuditLog {\n  id        String    @id @default(cuid())\n  userId    String\n  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  action    String    // 'signin' | 'mfa_setup' | 'consent_grant' | etc.\n  resource  String    // What was accessed/modified\n  status    String    // 'success' | 'failure'\n  details   String?   @db.Text\n  ipAddress String?\n  userAgent String?   @db.Text\n  timestamp DateTime  @default(now())\n\n  @@index([userId])\n  @@index([action])\n  @@index([timestamp])\n}\n\n/**\n * LAYER 4: AI ETHICS COMPLIANCE\n * AI Interaction Logging\n */\nmodel AIInteraction {\n  id            String    @id @default(cuid())\n  userId        String\n  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  timestamp     DateTime  @default(now())\n  userInput     String    @db.Text\n  aiResponse    String    @db.Text\n  responseType  String    // 'informational' | 'supportive' | 'educational' | 'referral'\n  ethicsScore   Int       // 0-100\n  violations    String?   @db.Text // JSON array of violations\n  approved      Boolean   @default(true)\n\n  @@index([userId])\n  @@index([timestamp])\n}\n\n/**\n * LAYER 2: DATA ENCRYPTION\n * Encrypted Data Vault for Sensitive Information\n */\nmodel EncryptedData {\n  id        String    @id @default(cuid())\n  userId    String\n  dataType  String    // 'behavioral_notes' | 'recovery_plan' | etc.\n  encrypted String    @db.Text // AES-256-GCM encrypted\n  iv        String    // Initialization vector\n  authTag   String    // Authentication tag\n  createdAt DateTime  @default(now())\n  updatedAt DateTime  @updatedAt\n\n  @@index([userId])\n}\n\n/**\n * LAYER 7: COMPLIANCE FRAMEWORK\n * Data Export Records\n */\nmodel DataExport {\n  id        String    @id @default(cuid())\n  userId    String\n  format    String    // 'json' | 'csv'\n  dataTypes String[]  // Which data was exported\n  filePath  String?   // Temporary storage path\n  createdAt DateTime  @default(now())\n  expiresAt DateTime  // Export link expires after 7 days\n  downloaded Boolean  @default(false)\n  downloadedAt DateTime?\n}\n\n/**\n * LAYER 7: COMPLIANCE FRAMEWORK\n * Data Deletion Requests\n */\nmodel DataDeletion {\n  id        String    @id @default(cuid())\n  userId    String\n  dataTypes String[]  // Which data to delete\n  status    String    // 'pending' | 'processing' | 'completed'\n  reason    String?   @db.Text\n  createdAt DateTime  @default(now())\n  completedAt DateTime?\n}\n\n/**\n * Indexes for Performance\n */\n"